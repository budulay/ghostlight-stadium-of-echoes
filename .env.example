# GHOSTLIGHT: STADIUM OF ECHOES - Configuration

# Server Port
PORT=3001

# Ollama Host Endpoint (default local installation)
OLLAMA_HOST=http://localhost:11434

# Open-Weight AI Model for Memory Extraction
# Recommended: gemma3:4b (requires 'ollama pull gemma3:4b')
# Compatible with other open models: gemma2:2b, llama3.2:3b, mistral:7b
GEMMA_MODEL=gemma3:4b

# Optional Neural Voice Narrator (ElevenLabs)
# If omitted, Ghostlight defaults to the zero-dependency browser SpeechSynthesis API.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
